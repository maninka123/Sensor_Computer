# Canonical ROS 1 network configuration for the sensing device.
# ROS_IP tells ROS which address to advertise; it does not assign that address
# to eth0. The operating-system NetworkManager profile must also assign
# 10.20.0.21/24. This device keeps its DHCP address for normal network access
# and uses 10.20.0.21 as a fixed secondary address for the private ROS link.
# Keep ROS_IP as a literal, statically assigned IPv4 address.
ROS_IP=10.20.0.21
# The sensing device hosts roscore so acquisition starts without the Surface PC.
# Surface clients use this same URI when they connect later.
ROS_MASTER_URI=http://10.20.0.21:11311

# Fixed ROSBridge listener. Clients connect to ws://10.20.0.21:9090.
ROSBRIDGE_ADDRESS=0.0.0.0
ROSBRIDGE_PORT=9090

# Automatic client transport selection. ROSBridge is available at boot, then
# stops after a remote native ROS node consumes the final fused output directly
# from pointcloud_colorizer. A camera-only native subscriber must not stop a
# bridge that may still carry the point cloud. It returns after client loss.
TRANSPORT_NATIVE_TOPICS=/merged_colored_cloud
TRANSPORT_NATIVE_STABLE_SECONDS=15
TRANSPORT_NATIVE_LOST_SECONDS=45
TRANSPORT_POLL_SECONDS=2
TRANSPORT_STATUS_FILE=/run/node-pc-transport-status.json

# Hardware identifiers confirmed from the previous working workspace.
FLIR_CAMERA_SERIAL=24510717
FLIR_DEVICE_TYPE=GigE
# Persistent address stored in camera serial 24510717. The camera and primary
# ROS address deliberately share 10.20.0.0/24 so Spinnaker selects a usable
# transport interface even when eth0 also carries the Livox subnet.
FLIR_CAMERA_IP=10.20.0.22
FLIR_FRAME_RATE=35
# 1936x1464 / 4 = 484x366, matching the calibrated intrinsics in pipeline.yaml.
FLIR_X_BINNING=4
FLIR_Y_BINNING=4
# Conservative GigE transport for a standard MTU-1500 switch/network.
FLIR_PACKET_SIZE=1400
FLIR_PACKET_DELAY=1000
FLIR_STREAM_BUFFERS=64
# Keep automatic brightness adaptation, but allow a longer exposure than the
# driver's dark 5 ms default. 20 ms remains below the 28.6 ms period at 35 FPS.
FLIR_EXPOSURE_AUTO=Continuous
FLIR_AUTO_EXPOSURE_LIMIT_US=20000
FLIR_AUTO_GAIN=Continuous
# Lift shadows and midtones in-camera without changing resolution or frame rate.
FLIR_GAMMA_ENABLE=True
FLIR_GAMMA=0.75
# Recover edge definition lost to binning without amplifying colour noise.
FLIR_SHARPENING_ENABLE=True
FLIR_AUTO_SHARPNESS=True
# Saturation processing caused clipping/noise on the raw Bayer stream in testing.
FLIR_SATURATION_ENABLE=False
LIVOX_HOST_IP=192.168.1.50
LIVOX_DEVICE_IP=192.168.1.125
LIVOX_BROADCAST_CODE=3JEDLB30015Y251
