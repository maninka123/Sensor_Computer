<launch>
  <arg name="auto_timestamp_offset" default="false" />
  <!-- Load parameters for both nodes from one config file -->
  <rosparam file="$(find node_pc)/config/pipeline.yaml" command="load" />

  <node pkg="node_pc" type="lidar_timestamp_shift_node" name="lidar_timestamp_shift"
        output="screen" required="true">
    <param name="auto_timestamp_offset" value="$(arg auto_timestamp_offset)" />
  </node>

  <node pkg="node_pc" type="pointcloud_merge_node" name="pointcloud_merger"
        output="screen" required="true" />

  <!-- Filter every indexed source frame independently, preserving timestamps. -->
  <node pkg="node_pc" type="pointcloud_voxel_filter_node" name="pointcloud_voxel_filter"
        output="screen" required="true" />

  <node pkg="node_pc" type="image_enhancer.py" name="image_enhancer"
        output="screen" respawn="true" respawn_delay="5.0" />

  <node pkg="node_pc" type="pointcloud_colorize_node" name="pointcloud_colorizer"
        output="screen" required="true" />
</launch>
