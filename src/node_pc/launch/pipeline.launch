<launch>
  <!-- false: real FLIR/Livox sensors; true: raw topics supplied by rosbag. -->
  <arg name="rosbag" default="false" />
  <arg name="rosbridge" default="true" />
  <arg name="rosbridge_address" default="$(optenv ROSBRIDGE_ADDRESS 0.0.0.0)" />
  <arg name="rosbridge_port" default="$(optenv ROSBRIDGE_PORT 9090)" />
  <arg name="ros_ip" default="$(env ROS_IP)" />
  <arg name="ros_master_uri" default="$(env ROS_MASTER_URI)" />
  <arg name="camera_serial" default="$(optenv FLIR_CAMERA_SERIAL 24510717)" />
  <arg name="camera_device_type" default="$(optenv FLIR_DEVICE_TYPE GigE)" />
  <arg name="camera_frame_rate" default="$(optenv FLIR_FRAME_RATE 35)" />
  <arg name="camera_x_binning" default="$(optenv FLIR_X_BINNING 4)" />
  <arg name="camera_y_binning" default="$(optenv FLIR_Y_BINNING 4)" />
  <arg name="camera_packet_size" default="$(optenv FLIR_PACKET_SIZE 1400)" />
  <arg name="camera_packet_delay" default="$(optenv FLIR_PACKET_DELAY 1000)" />
  <arg name="camera_stream_buffers" default="$(optenv FLIR_STREAM_BUFFERS 64)" />
  <arg name="camera_exposure_auto" default="$(optenv FLIR_EXPOSURE_AUTO Continuous)" />
  <arg name="camera_auto_exposure_limit" default="$(optenv FLIR_AUTO_EXPOSURE_LIMIT_US 20000)" />
  <arg name="camera_auto_gain" default="$(optenv FLIR_AUTO_GAIN Continuous)" />
  <arg name="camera_gamma_enable" default="$(optenv FLIR_GAMMA_ENABLE True)" />
  <arg name="camera_gamma" default="$(optenv FLIR_GAMMA 0.8)" />
  <arg name="camera_sharpening_enable" default="$(optenv FLIR_SHARPENING_ENABLE True)" />
  <arg name="camera_auto_sharpness" default="$(optenv FLIR_AUTO_SHARPNESS True)" />
  <arg name="camera_saturation_enable" default="$(optenv FLIR_SATURATION_ENABLE False)" />
  <arg name="livox_broadcast_code" default="$(optenv LIVOX_BROADCAST_CODE 3JEDLB30015Y251)" />

  <!-- Keep the address used by every child explicit. run_pipeline.sh loads
       these values from config/network.env before roslaunch starts. -->
  <env name="ROS_IP" value="$(arg ros_ip)" />
  <env name="ROS_MASTER_URI" value="$(arg ros_master_uri)" />

  <!-- run_rosbags.sh publishes the recorded clock. Keep every downstream pipeline node
       on recorded time while testing, without starting either sensor driver. -->
  <param name="/use_sim_time" value="$(arg rosbag)" />

  <node pkg="node_pc" type="network_config_check.py" name="network_config_check"
        output="screen" required="false" />

  <!-- Optional hardware bringup when not playing rosbag -->
  <include file="$(find livox_ros_driver)/launch/livox_lidar.launch" unless="$(arg rosbag)">
    <arg name="bd_list" value="$(arg livox_broadcast_code)" />
  </include>
  <include file="$(find spinnaker_camera_driver)/launch/camera.launch" unless="$(arg rosbag)">
    <arg name="camera_serial" value="$(arg camera_serial)" />
    <arg name="device_type" value="$(arg camera_device_type)" />
    <arg name="frame_rate" value="$(arg camera_frame_rate)" />
    <arg name="x_binning" value="$(arg camera_x_binning)" />
    <arg name="y_binning" value="$(arg camera_y_binning)" />
    <arg name="gev_scps_packet_size" value="$(arg camera_packet_size)" />
    <arg name="gev_scpd" value="$(arg camera_packet_delay)" />
    <arg name="stream_buffer_count" value="$(arg camera_stream_buffers)" />
    <arg name="exposure_auto" value="$(arg camera_exposure_auto)" />
    <arg name="auto_exposure_time_upper_limit" value="$(arg camera_auto_exposure_limit)" />
    <arg name="auto_gain" value="$(arg camera_auto_gain)" />
    <arg name="gamma_enable" value="$(arg camera_gamma_enable)" />
    <arg name="gamma" value="$(arg camera_gamma)" />
    <arg name="sharpening_enable" value="$(arg camera_sharpening_enable)" />
    <arg name="auto_sharpness" value="$(arg camera_auto_sharpness)" />
    <arg name="saturation_enable" value="$(arg camera_saturation_enable)" />
  </include>

  <!-- Shift -> indexed stack -> per-frame filter -> timestamp-matched colorize. -->
  <include file="$(find node_pc)/launch/time_shift.launch">
    <arg name="auto_timestamp_offset" value="$(eval not arg('rosbag'))" />
  </include>

  <!-- Web-only components. Native TCPROS subscribers do not need either. -->
  <group if="$(arg rosbridge)">
    <node pkg="tf2_web_republisher" type="tf2_web_republisher" name="tf2_web_republisher" output="screen" />
    <node pkg="rosbridge_server" type="rosbridge_websocket" name="rosbridge_websocket" output="screen">
      <param name="address" value="$(arg rosbridge_address)" />
      <param name="port" value="$(arg rosbridge_port)" />
    </node>
  </group>

  <!-- IMU complementary filter -->
  <include file="$(find node_pc)/launch/imu_filter.launch" />

  <!-- Static TF between map and livox_frame (adjust if you have a calibrated transform) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="static_map_to_livox"
        args="0 0 0 0 0 0 map livox_frame" />
</launch>
