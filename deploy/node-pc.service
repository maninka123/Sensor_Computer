[Unit]
Description=Underground sensing and colourised point-cloud pipeline
Wants=network-online.target NetworkManager.service
After=network-online.target NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=rock
WorkingDirectory=/home/rock/catkin_ws_actual

# The single network file is authoritative for the device address and Master.
EnvironmentFile=/home/rock/catkin_ws_actual/src/node_pc/config/network.env
Environment="NODE_PC_NETWORK_CONFIG=/home/rock/catkin_ws_actual/src/node_pc/config/network.env"
Environment="ROSBAG=false"
# Web transport is managed independently by node-pc-rosbridge.service so it
# can stop after a native TCPROS client is established without touching the
# sensor or processing pipeline.
Environment="ROSBRIDGE=false"
Environment="PYTHONUNBUFFERED=1"

# Wait only for this sensor computer's persistent local addresses. The remote
# server may be disconnected and can connect to ROSBridge later.
ExecStartPre=/home/rock/catkin_ws_actual/scripts/wait_for_local_network.sh eth0 60
ExecStart=/home/rock/catkin_ws_actual/run_pipeline.sh
ExecStartPost=/home/rock/catkin_ws_actual/scripts/verify_pipeline_startup.sh 90
# Boot-time transport jobs are dropped if the sensor check fails once. Queue
# them again after every successful retry, without waiting on units ordered
# After=node-pc.service (which would deadlock this start-post phase).
# '+' grants only this fixed systemctl command the privileges needed to start
# units; '-' keeps a transport start failure from tearing down healthy sensors.
ExecStartPost=-+/usr/bin/systemctl --no-block start node-pc-rosbridge.service node-pc-transport-supervisor.service
Restart=always
RestartSec=10
# Network wait can use 60s and the sensor data check can use another 90s.
TimeoutStartSec=200
TimeoutStopSec=30
KillSignal=SIGINT
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=node-pc

[Install]
WantedBy=multi-user.target
